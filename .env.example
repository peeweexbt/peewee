# Copy to .env and fill in. Never commit .env.

# Claude — Peewee's brain (picks topics, writes concepts + tweets)
ANTHROPIC_API_KEY=

# X / Twitter — needs a developer app with Read+Write permissions and
# "OAuth 1.0a user context" keys generated AFTER you set Read+Write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Optional: Reddit official API (recommended; the public .json endpoints work without it but are rate-limited)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=peewee-paints/1.0 by u/yourname

# Optional: hosted fallback painter
REPLICATE_API_TOKEN=

# Optional: override config.yaml painter backend without editing the file (local|remote_sd|replicate|mock)
PEEWEE_PAINTER=
